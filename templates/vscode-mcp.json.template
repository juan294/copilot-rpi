{
  "inputs": [
    {
      "type": "promptString",
      "id": "example-token",
      "description": "Token for a reviewed MCP server",
      "password": true
    }
  ],
  "servers": {
    "example": {
      "type": "http",
      "url": "https://mcp.example.invalid/mcp",
      "headers": {
        "Authorization": "Bearer ${input:example-token}"
      }
    }
  }
}
