.claude/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Node (if used for linting tools)
node_modules/
# The lint toolchain is pinned for repeatable local verification.
!package-lock.json
yarn.lock

# Python development caches
__pycache__/
*.pyc
.venv/

# Environment
.env
.env.local

# Agent operational output (never committed)
docs/agents/
logs/
scripts/agents/
.rpi/local/

# Internal working docs
docs/research/
!docs/research/
docs/research/*
!docs/research/2026-09-28-blueprint-sync-state.md
docs/decisions/

# Plans stay local, but the deviation log /implement writes must survive to
# /validate. The `/*` matters: git cannot re-include a path whose parent
# DIRECTORY is excluded, so the obvious `docs/plans/` + negation does nothing.
docs/plans/*
!docs/plans/*-notes.md
!docs/plans/2026-09-28-copilot-blueprint-modernization.md
!docs/plans/2026-09-28-copilot-blueprint-modernization-phases/
docs/plans/2026-09-28-copilot-blueprint-modernization-phases/*
!docs/plans/2026-09-28-copilot-blueprint-modernization-phases/phase-*.md
